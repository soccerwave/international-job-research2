{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/llm_candidate_profile.schema.json",
  "title": "LLM Candidate Profile V1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "evidence_profile",
    "search_preferences",
    "guardrails",
    "evaluation_guidance"
  ],
  "properties": {
    "schema_version": {"const": "LLM_CANDIDATE_PROFILE_SCHEMA_V1.1"},
    "profile_version": {"const": "LLM_CANDIDATE_PROFILE_V1.1.0"},
    "evidence_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "career_stage",
        "education",
        "research_domains",
        "methods",
        "research_experience",
        "teaching_and_supervision",
        "professional_experience",
        "transferable_strengths",
        "languages"
      ],
      "properties": {
        "career_stage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current_level", "summary"],
          "properties": {
            "current_level": {"type": "string", "minLength": 1},
            "summary": {"type": "string", "minLength": 1}
          }
        },
        "education": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["degree", "field", "institution"],
            "properties": {
              "degree": {"type": "string", "minLength": 1},
              "field": {"type": "string", "minLength": 1},
              "institution": {"type": "string", "minLength": 1}
            }
          }
        },
        "research_domains": {"$ref": "#/$defs/nonemptyStringArray"},
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "level", "evidence"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "level": {
                "type": "string",
                "enum": ["CORE", "STRONG", "WORKING", "EXPOSURE", "DO_NOT_CLAIM"]
              },
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        },
        "research_experience": {"$ref": "#/$defs/nonemptyStringArray"},
        "teaching_and_supervision": {"$ref": "#/$defs/nonemptyStringArray"},
        "professional_experience": {"$ref": "#/$defs/nonemptyStringArray"},
        "transferable_strengths": {"$ref": "#/$defs/nonemptyStringArray"},
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "level", "evidence_source"],
            "properties": {
              "language": {"type": "string", "minLength": 1},
              "level": {"type": "string", "minLength": 1},
              "evidence_source": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "search_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_role_families", "core_domains", "adjacent_domains", "soft_preferences"],
      "properties": {
        "target_role_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "POSTDOC",
              "RESEARCH_FELLOW_POSTDOC",
              "ASSISTANT_PROFESSOR",
              "LECTURER",
              "RESEARCH_ASSISTANT_PROFESSOR",
              "TENURE_TRACK",
              "JUNIOR_PROFESSOR",
              "RESEARCH_SCIENTIST",
              "SCIENTIFIC_PROJECT_MANAGER",
              "RESEARCH_PROJECT_MANAGER",
              "RESEARCH_PROGRAMME_MANAGER",
              "OTHER_RESEARCH"
            ]
          }
        },
        "core_domains": {"$ref": "#/$defs/nonemptyStringArray"},
        "adjacent_domains": {"$ref": "#/$defs/nonemptyStringArray"},
        "soft_preferences": {"$ref": "#/$defs/stringArray"}
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_constraints", "do_not_infer"],
      "properties": {
        "hard_constraints": {"$ref": "#/$defs/stringArray"},
        "do_not_infer": {"$ref": "#/$defs/nonemptyStringArray"}
      }
    },
    "evaluation_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recall_priority", "transferable_fit", "title_handling", "eligibility_handling", "evidence_preference_separation"],
      "properties": {
        "recall_priority": {"type": "string", "minLength": 1},
        "transferable_fit": {"type": "string", "minLength": 1},
        "title_handling": {"type": "string", "minLength": 1},
        "eligibility_handling": {"type": "string", "minLength": 1},
        "evidence_preference_separation": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
