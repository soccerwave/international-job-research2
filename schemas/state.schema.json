{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:international-academic-job-search:state:1.0.0",
  "title": "International Academic Job Search Durable State",
  "type": "object",
  "additionalProperties": false,
  "required": ["state_version","generation","updated_at","last_run_id","writer_role","jobs"],
  "properties": {
    "state_version": {"const":"STATE_SCHEMA_V1.0.0"},
    "generation": {"type":"integer","minimum":0},
    "updated_at": {"type":["string","null"],"format":"date-time"},
    "last_run_id": {"type":["string","null"]},
    "writer_role": {"const":"CENTRAL_FINALIZER"},
    "jobs": {
      "type":"object",
      "additionalProperties": {
        "type":"object",
        "additionalProperties": false,
        "required":["state_id","aliases","first_seen_at","last_seen_at","times_seen","lifecycle_status","last_snapshot","last_event","last_change_reasons"],
        "properties": {
          "state_id":{"type":"string","pattern":"^job_[a-f0-9]{20}(?:_[0-9]+)?$"},
          "aliases":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
          "first_seen_at":{"type":"string","format":"date-time"},
          "last_seen_at":{"type":"string","format":"date-time"},
          "times_seen":{"type":"integer","minimum":1},
          "lifecycle_status":{"enum":["OPEN","CLOSED","UNKNOWN"]},
          "last_snapshot":{"type":"object"},
          "last_event":{"enum":["NEW","SEEN","MATERIALLY_CHANGED","REOPENED"]},
          "last_change_reasons":{"type":"array","items":{"type":"string"}}
        }
      }
    }
  }
}
