{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Shadow Experiment Evidence Bundle V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_date",
    "created_at",
    "model",
    "candidate_profile_version",
    "summary",
    "main_evaluations",
    "rescue_triage",
    "rescue_full_evaluations",
    "disagreements",
    "failures"
  ],
  "properties": {
    "schema_version": {
      "const": "LLM_EXPERIMENT_EVIDENCE_V0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "run_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 10
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "candidate_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "main_evaluations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rescue_triage": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rescue_full_evaluations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rescue_reject_audit": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
